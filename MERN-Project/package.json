{
  "name": "careerlabs",
  "version": "1.0.0",
  "description": "Career development and job search platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "concurrently \"npm test --prefix backend\" \"npm test --prefix frontend\"",
    "install-all": "npm install && npm install --prefix frontend && npm install --prefix backend",
    "build": "npm run build --prefix frontend",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix frontend && npm install --prefix backend && npm run build --prefix frontend",
    "docker-build": "docker-compose build",
    "docker-up": "docker-compose up",
    "docker-down": "docker-compose down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/careerlabs.git"
  },
  "keywords": [
    "career",
    "jobs",
    "mentoring",
    "development",
    "mern"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^7.6.0",
    "nodemon": "^2.0.22"
  },
  "engines": {
    "node": "16.x"
  }
} 